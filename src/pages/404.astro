---
import Base from '@/layouts/Base.astro';
import Footer from '@/components/contact/Footer.astro';
import Icon from '@/components/global/Icon.astro';
import site from '@/content/site';
import { noodleThrough } from '@/lib/noodle';

const { notFound, nav } = site;

/*
 * The chart: users over time for this page. The noodle climbs (with the
 * signature loop), wobbles, peaks, then falls off a cliff and flatlines at
 * zero. Drawn in a 640 × 360 box; the zero line is the x-axis.
 */
const VB_W = 640;
const VB_H = 360;
const O = { x: 58, y: 300 }; // origin
const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(2)}%`;

// the climb: one loop along a rising slope
const start = { x: O.x + 4, y: O.y - 6 };
const rise = { x: 228, y: -120 };
const len = Math.hypot(rise.x, rise.y);
const ux = rise.x / len;
const uy = rise.y / len;
const climb = noodleThrough([70, 165], {
  start: 0,
  end: len,
  vScale: 0.48,
  map: (u, v) => [start.x + u * ux + v * uy, start.y + u * uy - v * ux],
});

// the hype, the cliff, the thud, the flatline
const impact = { x: 454, y: O.y };
const flatEnd = { x: 598, y: O.y };
const crash = [
  'C 306 166, 318 182, 334 175', // wobble
  'C 352 167, 362 126, 382 96', // hype
  'C 394 78, 404 62, 414 64', // peak
  'C 424 66, 428 120, 434 190', // cliff
  `C 440 252, 442 ${O.y - 2}, ${impact.x} ${impact.y}`, // thud
  `C 460 ${O.y + 1}, 463 ${O.y - 7}, 468 ${O.y - 7}`, // tiny bounce
  `C 473 ${O.y - 7}, 475 ${O.y}, 482 ${O.y}`,
  `L ${flatEnd.x} ${flatEnd.y}`, // flatline
].join(' ');
const line = `${climb} ${crash}`;

// keep hyphenated words (product-market) from breaking at the hyphen
const titleWords = notFound.title.split(' ');
---

<Base title={`404 · ${notFound.title}`} description={notFound.body} path="/404" noindex>
  <section class="nf wrap" aria-labelledby="nf-title">
    <p class="kicker nf-kicker"><span class="num">404</span>page not found</p>

    <h1 id="nf-title" class="nf-title">
      {
        titleWords.map((w, i) => (
          <>
            {w.includes('-') ? <span class="whitespace-nowrap">{w}</span> : w}
            {i < titleWords.length - 1 && ' '}
          </>
        ))
      }
    </h1>

    <div class="nf-grid">
      <figure class="nf-card">
        <div class="nf-pointer" aria-hidden="true">
          <span class="label">exhibit a</span>
          <svg viewBox="0 0 120 130" focusable="false">
            <path class="noodle nf-pointer__line" pathLength="1" stroke-width="3.5" d="M 6 20 C 30 14, 52 16, 62 34 C 70 50, 56 64, 46 54 C 36 44, 52 28, 70 36 C 90 46, 96 80, 96 118"></path>
            <path class="noodle nf-pointer__head" stroke-width="3.5" d="M 86 106 L 96 120 L 107 106"></path>
          </svg>
        </div>
        <figcaption class="nf-card__strip">
          <span class="label whitespace-nowrap">users over time</span>
          <span class="mono nf-card__path" data-nf-path>this page</span>
          <span class="label nf-card__chip">404</span>
          <span class="visually-hidden">
            : a line climbs, wobbles, then crashes to zero and flatlines. Product-market fit: not found.
          </span>
        </figcaption>

        <div class="nf-chart" style={`aspect-ratio:${VB_W} / ${VB_H}`}>
          <svg viewBox={`0 0 ${VB_W} ${VB_H}`} class="nf-chart__svg" aria-hidden="true" focusable="false">
            <g class="nf-chart__grid">
              {[84, 156, 228].map((y) => <path d={`M${O.x} ${y}H${VB_W - 30}`} />)}
            </g>
            <g class="nf-chart__axes noodle">
              <path d={`M${O.x} ${O.y}V22M${O.x - 7} 31L${O.x} 21L${O.x + 7} 31`} />
              <path d={`M${O.x} ${O.y}H${VB_W - 18}M${VB_W - 27} ${O.y - 7}L${VB_W - 17} ${O.y}L${VB_W - 27} ${O.y + 7}`} />
            </g>
            <path class="noodle nf-line" pathLength="1" d={line} stroke-width="6"></path>
            <g class="noodle nf-thud" stroke-width="3.5">
              <path d={`M${impact.x + 14} ${impact.y - 22}l8 -11`} />
              <path d={`M${impact.x + 22} ${impact.y - 10}l13 -4`} />
              <path d={`M${impact.x - 22} ${impact.y - 16}l-9 -9`} />
            </g>
            <circle class="nf-dot" cx={flatEnd.x} cy={flatEnd.y} r="7.5"></circle>
          </svg>

          <span class="label nf-axis nf-axis--y" style={`left:${pct(O.x + 16, VB_W)};top:${pct(14, VB_H)}`} aria-hidden="true">users</span>
          <span class="label nf-axis nf-axis--x" style={`right:${pct(22, VB_W)};top:${pct(O.y + 14, VB_H)}`} aria-hidden="true">time</span>
          <span class="mono nf-axis nf-axis--zero" style={`right:${pct(VB_W - O.x + 10, VB_W)};top:${pct(O.y, VB_H)}`} aria-hidden="true">0</span>
          <span class="sticker nf-sticker" style={`--x:${pct(impact.x + 24, VB_W)};--y:${pct(VB_H - O.y + 46, VB_H)}`} aria-hidden="true">pmf: not found</span>
        </div>
      </figure>

      <div class="nf-copy">
        <p class="nf-body">{notFound.body}</p>

        <div class="nf-ctas">
          <a href="/" class="btn btn-lime">
            Pivot to the homepage
            <svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M9 14 4 9l5-5M4 9h10.5a5.5 5.5 0 0 1 0 11H11"></path>
            </svg>
          </a>
          <button type="button" class="btn js-only" data-palette-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K /">
            <Icon name="command" class="size-5" stroke={2.25} />
            Open the command menu
          </button>
        </div>

        <nav class="nf-jump" aria-label="Homepage sections">
          <p class="label">or jump to</p>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} class="pill nf-pill">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .nf {
    padding-block: 1.75rem 4.5rem;
  }
  @media (min-width: 64rem) {
    .nf {
      padding-block: 2.25rem 6rem;
    }
  }

  .nf-title {
    margin-top: 1rem;
    max-width: 18ch;
    /* "product-market fit." is ~8.4em wide: on the narrowest phones shrink
       just enough that it stays one line instead of orphaning "fit." */
    font-size: min(var(--text-display), calc((100vw - 2rem) / 8.6));
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
  }
  @media (min-width: 64rem) {
    .nf-title {
      max-width: none;
    }
  }

  /* layout: stacked on phones (title → chart → copy), copy | chart on desktop */
  .nf-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 64rem) {
    .nf-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-areas: 'copy chart';
      align-items: center;
      gap: 3.5rem;
      margin-top: 2.75rem;
    }
    .nf-card {
      grid-area: chart;
    }
    .nf-copy {
      grid-area: copy;
    }
  }

  /* the dashboard card */
  .nf-card {
    position: relative;
    margin: 0;
    margin-right: 10px;
    background: var(--surface);
    border: 3px solid var(--line);
    border-radius: 18px;
    box-shadow:
      10px 10px 0 0 var(--tomato),
      10px 10px 0 3px var(--line);
  }
  @media (min-width: 64rem) {
    .nf-card {
      rotate: 1deg;
      box-shadow:
        14px 14px 0 0 var(--tomato),
        14px 14px 0 3px var(--line);
    }
  }
  .nf-card__strip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.7rem 0.9rem 0.7rem 1.1rem;
    color: var(--bg);
    background: var(--fg);
    border-radius: 15px 15px 0 0;
  }
  .nf-card__path {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    font-size: 0.8125rem;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0.8;
  }
  .nf-card__chip {
    flex: none;
    padding: 0.2rem 0.5rem;
    color: var(--ink);
    background: var(--tomato);
    border-radius: 6px;
  }

  .nf-chart {
    position: relative;
    margin: 0.5rem 0.75rem 0.75rem 0.25rem;
    container-type: inline-size;
  }
  .nf-chart__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .nf-chart__grid path {
    stroke: var(--line);
    stroke-width: 1.5;
    stroke-dasharray: 2 7;
    stroke-linecap: round;
    opacity: 0.35;
  }
  .nf-chart__axes {
    stroke-width: 2.5;
    opacity: 0.55;
  }
  .nf-dot {
    fill: var(--tomato);
    stroke: var(--line);
    stroke-width: 3;
  }

  .nf-axis {
    position: absolute;
    line-height: 1;
    color: var(--muted);
    pointer-events: none;
  }
  .nf-axis--zero {
    translate: 0 -50%;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  /* phones: slapped over the card's bottom edge, clear of the cliff.
     wider: sitting on the flatline, sized to the chart so it never overhangs */
  .nf-sticker {
    --r: -5deg;
    position: absolute;
    right: 0.25rem;
    bottom: -1.75rem;
    font-size: 0.8125rem;
    background: var(--tomato);
  }
  @media (min-width: 40rem) {
    .nf-sticker {
      right: auto;
      left: var(--x);
      bottom: var(--y);
      font-size: clamp(0.8125rem, 2.55cqi + 1px, 1.25rem);
    }
  }

  /* desktop: a noodle from the headline into the chart */
  .nf-pointer {
    display: none;
  }
  @media (min-width: 64rem) {
    .nf-pointer {
      position: absolute;
      bottom: calc(100% + 0.35rem);
      left: 40%;
      display: block;
      width: 7.5rem;
      color: var(--fg);
      pointer-events: none;
    }
    .nf-pointer .label {
      position: absolute;
      bottom: calc(100% - 0.5rem);
      left: -0.25rem;
      color: var(--muted);
      rotate: -4deg;
      white-space: nowrap;
    }
    .nf-pointer svg {
      width: 100%;
      height: auto;
      overflow: visible;
    }
  }

  /* copy */
  .nf-body {
    max-width: 34ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }
  .nf-ctas {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }
  @media (min-width: 26rem) {
    .nf-ctas {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
  :global(html:not(.js)) .js-only {
    display: none;
  }

  .nf-jump {
    margin-top: 2.25rem;
    padding-top: 1.25rem;
    border-top: 2px dashed color-mix(in srgb, var(--line) 30%, transparent);
  }
  .nf-jump .label {
    color: var(--muted);
  }
  .nf-jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .nf-pill {
    min-height: 2.25rem;
    text-decoration: none;
    transition:
      background-color 0.15s,
      color 0.15s,
      translate 0.18s var(--ease-snap);
  }
  .nf-pill:hover {
    color: var(--ink);
    background: var(--lime);
    translate: 0 -2px;
  }

  /* motion: draw the climb, crash, thud, slap the sticker on, then the monitor beeps */
  @media (prefers-reduced-motion: no-preference) {
    .nf-pointer__line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: nn-draw 0.7s var(--ease-out) 0.1s forwards;
    }
    .nf-pointer__head {
      opacity: 0;
      animation: nf-in 0.01s linear 0.75s forwards;
    }
    .nf-line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: nn-draw 2s cubic-bezier(0.5, 0, 0.75, 1) 0.3s forwards;
    }
    .nf-thud {
      opacity: 0;
      animation: nf-thud 0.45s var(--ease-snap) 1.85s forwards;
      transform-box: fill-box;
      transform-origin: center;
    }
    /* four beeps (< 5s, WCAG 2.2.2), then the dot stays solid */
    .nf-dot {
      opacity: 0;
      animation:
        nf-in 0.01s linear 2.3s forwards,
        nn-blink 1.1s steps(1) 2.4s 4;
    }
    .nf-sticker {
      animation: nf-slap 0.55s var(--ease-spring) 2.05s both;
    }
  }
  @keyframes nf-thud {
    from {
      opacity: 0;
      scale: 0.4;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }
  @keyframes nf-in {
    to {
      opacity: 1;
    }
  }
  @keyframes nf-slap {
    from {
      opacity: 0;
      scale: 0.5;
      rotate: -16deg;
    }
    to {
      opacity: 1;
      scale: 1;
      rotate: var(--r);
    }
  }
</style>

<script>
  // Show the path that missed. Text only, never HTML.
  const el = document.querySelector<HTMLElement>('[data-nf-path]');
  const path = location.pathname;
  if (el && path !== '/404' && path !== '/404.html') {
    let shown = path;
    try {
      shown = decodeURI(path);
    } catch {
      /* malformed escape: show it raw */
    }
    el.textContent = shown;
  }
</script>

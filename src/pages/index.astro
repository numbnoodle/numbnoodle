---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/hero/Hero.astro';
import Pipeline from '@/components/pipeline/Pipeline.astro';
import Shipped from '@/components/shipped/Shipped.astro';
import Toolbox from '@/components/toolbox/Toolbox.astro';
import Manual from '@/components/manual/Manual.astro';
import Contact from '@/components/contact/Contact.astro';
import Footer from '@/components/contact/Footer.astro';
---

<Base path="/">
  <Hero />
  <Pipeline />
  <Shipped />
  <Toolbox />
  <Manual />
  <Contact />
  <Footer slot="footer" />
</Base>

---
import site from '@/content/site';
import Icon from './Icon.astro';
import NoodleMark from './NoodleMark.astro';
---

<header class="wrap relative z-30 flex items-center justify-between gap-3 pt-4 pb-2 sm:pt-6">
  <a href="/" class="group flex items-center gap-2.5 rounded-xl no-underline" aria-label="numbnoodle: home">
    <NoodleMark class="size-9 transition-transform duration-300 [transition-timing-function:var(--ease-spring)] group-hover:-rotate-12" />
    <span class="font-display text-[1.375rem] leading-none font-extrabold tracking-[-0.03em]">numbnoodle</span>
  </a>

  <nav aria-label="Primary" class="hidden lg:block">
    <ul class="flex items-center gap-1">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="label rounded-full border-2 border-transparent px-3 py-1.5 no-underline transition-colors hover:border-line hover:bg-surface"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="flex items-center gap-2.5">
    <button
      type="button"
      data-palette-open
      class="js-only btn btn-sm gap-2 px-3.5"
      aria-haspopup="dialog"
      aria-keyshortcuts="Control+K Meta+K /"
    >
      <Icon name="command" class="size-4" stroke={2.25} />
      <span class="label hidden sm:inline">K</span>
      <span class="label sm:hidden">menu</span>
      <span class="visually-hidden">Open command menu</span>
    </button>
    <button
      type="button"
      data-theme-toggle
      class="js-only btn btn-sm size-10 min-h-0 p-0"
      aria-label="Dark mode"
      aria-pressed="false"
    >
      <Icon name="moon" class="theme-icon-moon size-[1.15rem]" />
      <Icon name="sun" class="theme-icon-sun size-[1.15rem]" />
    </button>
  </div>
</header>

<style>
  :global(html:not(.js)) .js-only {
    display: none;
  }
  :global(.theme-icon-sun) {
    display: none;
  }
  :global([data-theme='dark'] .theme-icon-sun) {
    display: block;
  }
  :global([data-theme='dark'] .theme-icon-moon) {
    display: none;
  }
</style>

<script>
  import { currentTheme, toggleTheme } from '@/lib/theme';
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () => btn?.setAttribute('aria-pressed', String(currentTheme() === 'dark'));
  sync();
  btn?.addEventListener('click', () => {
    toggleTheme();
  });
  window.addEventListener('nn:theme', sync);
</script>

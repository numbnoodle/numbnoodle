---
/**
 * Desktop table of contents: a sticky rail where the chapters sit on one
 * noodle, like the pipeline stations. The noodle draws with reading progress
 * and the current chapter lights up. Without JS (or with reduced motion) it's
 * a plain, fully drawn list of links.
 */
import type { Project } from '@/content/site';
import Icon from '@/components/global/Icon.astro';
import { noodleThrough } from '@/lib/noodle';
import { fileNum, type Chapter } from './chapters';

interface Props {
  chapters: Chapter[];
  project: Project;
  index: number;
}
const { chapters, project: p, index } = Astro.props;

// Geometry in rem-pixels (16 = 1rem). Rows are a fixed 3.25rem, the SVG is
// sized in rem too, so the noodle scales with the text and always hits the dots.
const ROW = 52;
const X = 24;
const ys = chapters.map((_, i) => ROW / 2 + i * ROW);
const H = chapters.length * ROW;
const d = noodleThrough(ys, { start: 0, end: H, vScale: 0.2, map: (u, v) => [X + v, u] });
---

<nav class="case-toc" aria-label="Chapters" data-case-toc style={`--rows:${chapters.length}`}>
  <p class="label case-toc__head">
    <span>case file {fileNum(index)}</span>
    <span class="case-toc__count">{String(chapters.length).padStart(2, '0')} chapters</span>
  </p>

  <div class="case-toc__track">
    <svg class="case-toc__svg" viewBox={`0 0 48 ${H}`} aria-hidden="true">
      <path class="noodle case-toc__ghost" d={d} stroke-width="2.5"></path>
      <path class="noodle case-toc__draw" data-toc-draw data-stops={JSON.stringify(ys)} pathLength="1" d={d} stroke-width="3.5"></path>
    </svg>
    <ol class="case-toc__list">
      {
        chapters.map((c) => (
          <li>
            <a href={`#${c.anchor}`} class="case-toc__link" data-toc-link>
              <span class="case-toc__dot" aria-hidden="true">
                {c.num}
              </span>
              <span class="case-toc__title">{c.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <a href={p.url} class="case-toc__live label link" target="_blank" rel="noopener">
    {p.urlLabel}
    <Icon name="arrow-up-right" class="size-4" />
    <span class="visually-hidden">(opens in a new tab)</span>
  </a>
</nav>

<style is:global>
  .case-toc {
    display: none;
  }
  @media (min-width: 64rem) {
    .case-toc {
      display: block;
      align-self: start;
      padding-top: 0.5rem;
    }
  }
  @media (min-width: 64rem) and (min-height: 36rem) {
    .case-toc {
      position: sticky;
      top: 2rem;
    }
  }
  .case-toc__head {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.7rem;
    margin-bottom: 0.9rem;
    border-bottom: 3px solid var(--line);
  }
  .case-toc__count {
    color: var(--muted);
  }
  .case-toc__track {
    position: relative;
  }
  .case-toc__svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 3rem;
    height: calc(var(--rows) * 3.25rem);
    overflow: visible;
    color: var(--fg);
  }
  .case-toc__ghost {
    opacity: 0.2;
  }
  .case-toc__list {
    position: relative;
  }
  .case-toc__link {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: center;
    column-gap: 0.65rem;
    height: 3.25rem;
    text-decoration: none;
    border-radius: 10px;
  }
  .case-toc__dot {
    justify-self: center;
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--fg);
    background: var(--surface);
    border: 2.5px solid var(--line);
    border-radius: 50%;
    transition:
      background-color 0.2s,
      color 0.2s,
      scale 0.45s var(--ease-spring),
      rotate 0.45s var(--ease-spring);
  }
  .case-toc__title {
    justify-self: start;
    max-width: 100%;
    padding: 0.2rem 0.45rem;
    margin-left: -0.45rem;
    overflow: hidden;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    white-space: nowrap;
    text-overflow: ellipsis;
    border-radius: 6px;
    transition:
      background-color 0.2s,
      rotate 0.45s var(--ease-spring);
  }
  .case-toc__link:hover .case-toc__title {
    text-decoration: underline wavy var(--tomato);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .case-toc__link.is-past .case-toc__dot {
    color: var(--bg);
    background: var(--fg);
  }
  .case-toc__link[aria-current='true'] .case-toc__dot {
    color: var(--ink);
    background: var(--lime);
    border-color: var(--line);
    scale: 1.14;
    rotate: -8deg;
  }
  .case-toc__link[aria-current='true'] .case-toc__title {
    color: var(--ink);
    background: var(--lime);
    box-shadow: 0 0 0 2px var(--line);
    rotate: -1.5deg;
  }
  .case-toc__live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.4rem;
    margin-left: 0.4rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* live drawing: hidden until the script places the pen (no JS = fully drawn) */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .js .case-toc__draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
  }
</style>

<script>
  import { fractionsAt } from '@/lib/noodle';

  const toc = document.querySelector<HTMLElement>('[data-case-toc]');
  const draw = toc?.querySelector<SVGPathElement>('[data-toc-draw]');
  const links = toc ? [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')] : [];
  const sections = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => el !== null);

  if (toc && draw && sections.length === links.length && sections.length > 0) {
    // the "pen": a line a quarter of the way down the viewport
    const PEN = 0.25;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const rail = matchMedia('(min-width: 64rem)');
    const n = sections.length;

    let active = -2;
    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      links.forEach((a, j) => {
        if (j === i) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
        a.classList.toggle('is-past', j < i);
      });
    };

    // --- current chapter: IntersectionObserver on a thin band at the pen line
    const inBand = new Set<number>();
    let lockUntil = 0;
    const resolve = () => {
      if (performance.now() < lockUntil) return;
      if (inBand.size) return setActive(Math.min(...inBand));
      // between nothing: either above chapter 01 or past the last one
      const first = sections[0]!.getBoundingClientRect();
      setActive(first.top > innerHeight * PEN ? -1 : n);
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const i = sections.indexOf(e.target as HTMLElement);
            if (e.isIntersecting) inBand.add(i);
            else inBand.delete(i);
          });
          resolve();
        },
        { rootMargin: `-${PEN * 100}% 0px -${(1 - PEN) * 100 - 1}% 0px` },
      );
      sections.forEach((s) => io.observe(s));
    }

    // jumping via the TOC: light the target immediately, let the scroll settle
    links.forEach((a, i) =>
      a.addEventListener('click', () => {
        setActive(i);
        lockUntil = performance.now() + 1200;
      }),
    );
    const release = () => {
      if (!lockUntil) return;
      lockUntil = 0;
      resolve();
    };
    addEventListener('scrollend', release);
    addEventListener('wheel', release, { passive: true });
    addEventListener('touchstart', release, { passive: true });

    // --- reading progress: the noodle draws from dot to dot as you read
    let stops: Array<{ y: number; f: number }> = [];
    let raf = 0;
    const live = () => rail.matches && !reduce.matches;

    const measure = () => {
      const us: number[] = JSON.parse(draw.dataset.stops ?? '[]');
      const fr = fractionsAt(draw, us.map((u) => [24, u] as [number, number]));
      const tops = sections.map((s) => s.getBoundingClientRect().top + scrollY);
      const end = sections[n - 1]!.getBoundingClientRect().bottom + scrollY;
      stops = [{ y: tops[0]! - innerHeight * 0.3, f: 0 }, ...tops.map((y, i) => ({ y, f: fr[i] ?? 0 })), { y: end, f: 1 }];
    };

    const update = () => {
      raf = 0;
      if (!live() || !stops.length) return;
      const pen = scrollY + innerHeight * PEN;
      let f = 0;
      if (pen >= stops[stops.length - 1]!.y) f = 1;
      else if (pen > stops[0]!.y) {
        const i = stops.findIndex((s) => s.y > pen);
        const a = stops[i - 1]!;
        const b = stops[i]!;
        f = a.f + ((pen - a.y) / Math.max(1, b.y - a.y)) * (b.f - a.f);
      }
      draw.style.strokeDashoffset = String(1 - f);
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    const setup = () => {
      if (live()) {
        draw.style.strokeDasharray = '1';
        measure();
        update();
      } else {
        // static: fully drawn
        draw.style.strokeDasharray = 'none';
        draw.style.strokeDashoffset = '0';
      }
    };

    setup();
    addEventListener('scroll', schedule, { passive: true });
    let t = 0;
    const ro = new ResizeObserver(() => {
      clearTimeout(t);
      t = window.setTimeout(setup, 120);
    });
    ro.observe(document.body);
    [reduce, rail].forEach((m) => m.addEventListener('change', setup));
  }
</script>

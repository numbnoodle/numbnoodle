---
/** End of a case file: the other product as a "next" box, plus a contact nudge. */
import site, { type Project } from '@/content/site';
import Icon from '@/components/global/Icon.astro';
import { fileNum } from './chapters';

interface Props {
  project: Project;
  index: number;
}
const { project: p, index } = Astro.props;
const { contact, hero } = site;
---

<div class:list={['case-end wrap', `case-end--${p.accent}`]}>
  <section class:list={['case-next', `case-next--${p.accent}`]} aria-labelledby="case-next-title">
    <div class="case-next__strip">
      <h2 id="case-next-title" class="label">Next case file</h2>
      <span class="label">case file {fileNum(index)}</span>
    </div>
    <div class="case-next__body">
      <p class="label case-next__role">{p.role}</p>
      <p class="case-next__name">
        <a href={`/work/${p.slug}`} class="case-next__link">
          {p.name}<span class="visually-hidden">: read the case file</span>
        </a>
      </p>
      <p class="case-next__pitch">{p.pitch}</p>
      <span class="case-next__go" aria-hidden="true">
        Open case file
        <span class="case-next__arrow"><Icon name="arrow-right" class="size-5" stroke={3} /></span>
      </span>
    </div>
  </section>

  <section class="case-nudge" aria-labelledby="case-nudge-title">
    <p class="label case-nudge__kicker">{contact.kicker}</p>
    <h2 id="case-nudge-title" class="case-nudge__title">{contact.title}</h2>
    <p class="case-nudge__intro">{contact.intro}</p>
    <a href="/#contact" class="btn btn-lime case-nudge__btn">
      {hero.ctas.secondary.label}
      <Icon name="arrow-right" class="size-5" />
    </a>
  </section>
</div>

<style is:global>
  .case-end {
    display: grid;
    gap: 2.75rem;
    padding-block: 3rem 5rem;
  }
  @media (min-width: 64rem) {
    .case-end {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      align-items: stretch;
      gap: 3rem;
      padding-block: 4rem 7rem;
    }
  }

  /* next: a smaller product box, the whole card is the link */
  .case-next {
    --accent: var(--lime);
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 3px solid var(--line);
    border-radius: 18px;
    box-shadow:
      8px 8px 0 0 var(--accent),
      8px 8px 0 3px var(--line);
    transition:
      transform 0.25s var(--ease-snap),
      box-shadow 0.25s var(--ease-snap);
  }
  .case-next--tomato {
    --accent: var(--tomato);
  }
  @media (min-width: 64rem) {
    .case-next {
      rotate: -0.6deg;
    }
  }
  .case-next:hover {
    transform: translate(-3px, -3px);
    box-shadow:
      11px 11px 0 0 var(--accent),
      11px 11px 0 3px var(--line);
  }
  .case-next:has(.case-next__link:active) {
    transform: translate(5px, 5px);
    box-shadow:
      3px 3px 0 0 var(--accent),
      3px 3px 0 3px var(--line);
    transition-duration: 0.06s;
  }
  .case-next:has(.case-next__link:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 5px;
  }
  .case-next__strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    padding: 0.7rem 1.1rem;
    color: var(--ink);
    background: var(--accent);
    border-bottom: 3px solid var(--line);
    border-radius: 15px 15px 0 0;
  }
  .case-next__strip h2 {
    font-family: var(--font-mono);
    font-weight: 600;
  }
  .case-next__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.4rem 1.1rem 1.6rem;
  }
  @media (min-width: 48rem) {
    .case-next__body {
      padding: 2rem 2.25rem 2.25rem;
    }
  }
  .case-next__role {
    color: var(--muted);
  }
  .case-next__name {
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 1.4rem + 6vw, 6.25rem);
    line-height: 0.86;
    letter-spacing: -0.05em;
  }
  .case-next__link {
    text-decoration: none;
    border-radius: 6px;
  }
  /* stretch the link over the whole card */
  .case-next__link::after {
    content: '';
    position: absolute;
    inset: -3px;
    z-index: 1;
    border-radius: 18px;
  }
  .case-next__link:focus-visible {
    outline: none;
  }
  .case-next__pitch {
    margin-top: 1rem;
    max-width: 38ch;
    font-size: 1.125rem;
    line-height: 1.45;
  }
  .case-next__go {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 1.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
  }
  .case-next__arrow {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--ink);
    background: var(--accent);
    border: var(--bw) solid var(--line);
    border-radius: 50%;
    transition: translate 0.35s var(--ease-spring);
  }
  .case-next:hover .case-next__arrow {
    translate: 6px 0;
  }

  /* contact nudge: inverts with the theme (ink card on paper, paper card on ink) */
  .case-nudge {
    --focus: var(--bg);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.75rem 1.25rem 1.9rem;
    color: var(--bg);
    background: var(--fg);
    border: 3px solid var(--line);
    border-radius: 18px;
    box-shadow: 8px 8px 0 0 var(--lime), 8px 8px 0 3px var(--line);
  }
  @media (min-width: 48rem) {
    .case-nudge {
      padding: 2.25rem 2.25rem 2.4rem;
    }
  }
  @media (min-width: 64rem) {
    .case-nudge {
      rotate: 0.8deg;
    }
  }
  /* next card is lime: give the nudge the other accent so they don't twin */
  .case-end--lime .case-nudge {
    box-shadow: 8px 8px 0 0 var(--tomato), 8px 8px 0 3px var(--line);
  }
  .case-nudge__kicker {
    padding: 0.2rem 0.55rem;
    color: var(--ink);
    background: var(--lime);
    border-radius: 6px;
  }
  .case-nudge__title {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.5rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }
  .case-nudge__intro {
    margin-top: 1rem;
    max-width: 36ch;
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .case-nudge__btn {
    margin-top: auto;
    --line: var(--bg);
  }
  .case-nudge__intro + .case-nudge__btn {
    margin-top: 1.75rem;
  }
</style>

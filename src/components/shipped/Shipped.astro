---
import site from '@/content/site';
import SectionHead from '@/components/global/SectionHead.astro';
import LaunchCard from './LaunchCard.astro';
import EarlierRow from './EarlierRow.astro';

const { shipped, projects } = site;
---

<section id="shipped" class="shipped wrap" aria-labelledby="shipped-title">
  <SectionHead num="02" kicker={shipped.kicker} id="shipped-title">
    {shipped.title}
    <p slot="after" class="section-intro">{shipped.intro}</p>
  </SectionHead>

  <div class="shipped__boxes">
    {projects.map((p, i) => <LaunchCard project={p} index={i} />)}
  </div>

  <EarlierRow />
</section>

<style is:global>
  .shipped {
    padding-block: 5rem 4rem;
  }
  @media (min-width: 64rem) {
    .shipped {
      padding-block: 7rem 6rem;
    }
  }
  .shipped__boxes {
    display: grid;
    gap: 3.5rem;
    margin-top: 3rem;
  }
  @media (min-width: 64rem) {
    .shipped__boxes {
      gap: 5rem;
      margin-top: 4rem;
    }
  }

  /* ---------- the product box ---------- */
  .box {
    --accent: var(--lime);
    position: relative;
    background: var(--surface);
    border: 3px solid var(--line);
    border-radius: 18px;
    box-shadow:
      10px 10px 0 0 var(--accent),
      10px 10px 0 3px var(--line);
  }
  .box--tomato {
    --accent: var(--tomato);
  }
  @media (min-width: 64rem) {
    .box {
      box-shadow:
        14px 14px 0 0 var(--accent),
        14px 14px 0 3px var(--line);
    }
    .box:nth-child(1) {
      rotate: -0.6deg;
    }
    .box:nth-child(2) {
      rotate: 0.5deg;
    }
  }
  .box__strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.25rem;
    padding: 0.75rem 1.1rem;
    background: var(--accent);
    color: var(--ink);
    border-bottom: 3px solid var(--line);
    border-radius: 15px 15px 0 0;
  }
  .box__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .box__live-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .box__live-dot {
      animation: nn-blink 1.4s steps(1) infinite;
    }
  }
  .box__url {
    margin-left: auto;
    text-transform: none;
  }
  .box__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding: 1.4rem 1.1rem 1.6rem;
  }
  @media (min-width: 48rem) {
    .box__body {
      padding: 2rem 2rem 2.25rem;
    }
  }
  @media (min-width: 64rem) {
    .box__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: 3rem;
      padding: 2.5rem 2.75rem 2.75rem;
    }
  }
  .box__brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .box__role {
    color: var(--muted);
  }
  .phone__brand {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
  }
  .box__period {
    white-space: nowrap;
  }
  .box__name {
    margin-top: 0.75rem;
    font-size: clamp(3.25rem, 1.5rem + 7vw, 7.5rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }
  .box__pitch {
    margin-top: 1rem;
    max-width: 34ch;
    font-size: var(--text-lead);
    line-height: 1.4;
  }

  .box__metrics {
    margin-top: 2rem;
  }
  .box__metrics-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .box__metrics-note {
    padding: 0.15rem 0.5rem;
    color: var(--ink);
    background: var(--accent);
    border: 2px solid var(--ink);
    border-radius: 999px;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .box__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 0.75rem;
    border: var(--bw) solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg);
  }
  @media (min-width: 40rem) {
    .box__grid {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
  }
  .box__metric {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 0.9rem 1rem 1rem;
    border-right: var(--bw) solid var(--line);
    border-bottom: var(--bw) solid var(--line);
    margin: 0 calc(var(--bw) * -1) calc(var(--bw) * -1) 0;
  }
  .box__metric-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .box__metric-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--muted);
  }

  .box__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .box__hats {
    margin-top: 2rem;
  }
  .box__hat-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.6rem;
  }

  /* side: phone + stamp */
  .box__side {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
  }
  .phone {
    width: min(100%, 15rem);
    padding: 0.55rem;
    background: var(--ink);
    border: 3px solid var(--line);
    border-radius: 2.1rem;
    box-shadow: 6px 6px 0 0 var(--line);
    rotate: 2.5deg;
  }
  .box--tomato .phone {
    rotate: -2.5deg;
  }
  .phone__screen {
    aspect-ratio: 9 / 19.5;
    overflow: hidden;
    border-radius: 1.6rem;
    background: var(--paper-hi);
  }
  .phone__screen > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .phone__placeholder {
    display: grid;
    align-content: space-between;
    height: 100%;
    padding: 1.6rem 0.9rem 1rem;
    color: var(--ink);
    background:
      repeating-linear-gradient(-45deg, transparent 0 12px, rgb(20 19 17 / 0.05) 12px 13px),
      var(--paper-hi);
  }
  .phone__logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    letter-spacing: -0.04em;
    line-height: 1;
    padding: 0.35rem 0.5rem;
    width: max-content;
    max-width: 100%;
    background: var(--accent);
    border: 2.5px solid var(--ink);
    border-radius: 0.5rem;
    rotate: -3deg;
  }
  .phone__todo {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.45;
    padding: 0.6rem;
    background: #fff3a8;
    border: 2px dashed var(--ink);
    border-radius: 0.5rem;
    overflow-wrap: anywhere;
  }
  @media (max-width: 63.99rem) {
    .box__side {
      grid-template-columns: auto auto;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
    }
    .phone {
      width: min(11.5rem, 50vw);
    }
    .stamp {
      width: min(7.5rem, 30vw);
      height: auto;
    }
  }

  .stamp {
    width: 7.5rem;
    height: 7.5rem;
    color: var(--ink);
    rotate: -14deg;
    transition: rotate 0.8s var(--ease-spring);
  }
  @media (min-width: 64rem) {
    .stamp {
      position: absolute;
      top: 46%;
      left: -1.75rem;
    }
    .box:hover .stamp {
      rotate: 20deg;
    }
  }
  .stamp__ring {
    fill: var(--accent);
    stroke: var(--ink);
    stroke-width: 3;
  }
  .stamp circle + circle {
    fill: var(--paper-hi);
  }
  .stamp__text {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    fill: var(--ink);
  }
  .stamp__check {
    fill: none;
    stroke: var(--ink);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .box__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    border-top: 3px dashed var(--line);
  }
  @media (min-width: 64rem) {
    .box__foot {
      padding: 1rem 2.75rem;
    }
  }
  .box__assembled {
    color: var(--muted);
  }
  .barcode {
    flex: none;
    width: 7rem;
    height: 1.9rem;
    fill: var(--fg);
  }
</style>

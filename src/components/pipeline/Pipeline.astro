---
import site from '@/content/site';
import SectionHead from '@/components/global/SectionHead.astro';
import { noodleThrough } from '@/lib/noodle';
import Icon from '@/components/global/Icon.astro';

const { pipeline } = site;
const W = 1200;
const BASE = 112;
const xs = pipeline.stations.map((_, i) => ((i + 0.5) / pipeline.stations.length) * W);
const d = noodleThrough(xs, { start: -20, end: W + 20, map: (u, v) => [u, BASE - v] });
const fallbackV = noodleThrough([60, 340, 620, 900, 1180], {
  start: 0,
  end: 1240,
  vScale: 0.3,
  map: (u, v) => [32 + v, u],
});
---

<section id="pipeline" class="pipeline" data-pipeline aria-labelledby="pipeline-title">
  <div class="pipeline__pin">
    <div class="wrap">
      <div class="pipeline__head">
        <SectionHead num="01" kicker={pipeline.kicker} id="pipeline-title">
          {
            pipeline.stations.map((s, i) => (
              <>
                <span class="pw" data-word={i}>{s.name}</span>
                {i < pipeline.stations.length - 1 && (
                  <Icon name="arrow-right" class="pw-arrow" stroke={3} />
                )}
                {i < pipeline.stations.length - 1 && <span class="visually-hidden">, then</span>}
              </>
            ))
          }
          <p slot="after" class="section-intro">{pipeline.intro}</p>
        </SectionHead>
      </div>

      <div class="pipeline__stage" aria-hidden="true">
          <p class="pipeline__counter label" aria-hidden="true">
          station <span data-counter>05</span>/05 · <span data-counter-name>{pipeline.stations.at(-1)?.name}</span>
        </p>
        <svg viewBox={`0 0 ${W} 224`} class="pipeline__svg" preserveAspectRatio="xMidYMid meet">
          <path class="noodle pipeline__track" d={d} stroke-width="3"></path>
          <path class="noodle pipeline__draw" data-draw pathLength="1" d={d} stroke-width="7"></path>
          {
            xs.map((x, i) => (
              <g class="pipeline__dot" data-dot={i} transform={`translate(${x} ${BASE})`}>
                <circle r="19" />
                <text y="5.5" text-anchor="middle">
                  {String(i + 1).padStart(2, '0')}
                </text>
              </g>
            ))
          }
        </svg>
      </div>

      <div class="pipeline__body">
        <svg class="pipeline__vsvg" data-vnoodle aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 64 1240">
          <path class="noodle pipeline__track" data-vtrack d={fallbackV} stroke-width="3" vector-effect="non-scaling-stroke"></path>
          <path class="noodle pipeline__draw" data-vdraw pathLength="1" d={fallbackV} stroke-width="6" vector-effect="non-scaling-stroke"></path>
        </svg>
        <ol class="pipeline__list">
          {
            pipeline.stations.map((s, i) => (
              <li class="station" data-station={i} style={`--tilt:${[-1.5, 1.2, -0.8, 1.5, -1][i]}deg`}>
                <span class="station__dot" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <article class="station__card">
                  <p class="label station__meta">
                    <span>station {String(i + 1).padStart(2, '0')}</span>
                    <span class="station__verb">{s.verb}</span>
                  </p>
                  <h3 class="station__name">{s.name}</h3>
                  <p class="station__what">{s.what}</p>
                  <p class="station__proof">
                    <span class="station__proof-tag">proof</span>
                    {s.proof}
                  </p>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .pipeline {
    position: relative;
    padding-block: 5rem 4rem;
  }
  .pipeline .section-title {
    font-size: clamp(2.1rem, 1rem + 4.6vw, 4.5rem);
    line-height: 1;
  }
  .pw {
    display: inline-block;
    padding: 0 0.08em;
    border-radius: 0.12em;
    transition:
      background-color 0.2s,
      color 0.2s,
      opacity 0.3s,
      rotate 0.5s var(--ease-spring);
  }
  .pw-arrow {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    margin-inline: 0.06em;
    vertical-align: 0.04em;
    color: var(--muted);
  }
  /* active station word gets the marker */
  .pipeline .pw.is-current {
    background: var(--lime);
    color: var(--ink);
    rotate: -2deg;
    box-shadow: 0 0 0 2px var(--line);
  }
  .pipeline__counter {
    display: none;
  }

  /* desktop stage */
  .pipeline__stage {
    display: none;
  }
  .pipeline__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .pipeline__track {
    stroke: var(--fg);
    opacity: 0.18;
    stroke-dasharray: 2 10;
  }
  .pipeline__draw {
    stroke: var(--fg);
  }
  .pipeline__dot circle {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 3;
    transition:
      fill 0.2s,
      r 0.4s var(--ease-spring);
  }
  .pipeline__dot text {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 15px;
    fill: var(--fg);
  }
  .pipeline__dot.is-on circle {
    fill: var(--lime);
    r: 22;
  }
  .pipeline__dot.is-on text {
    fill: var(--ink);
  }

  /* list: mobile-first vertical noodle */
  .pipeline__body {
    position: relative;
    margin-top: 2.5rem;
  }
  .pipeline__vsvg {
    position: absolute;
    left: 0;
    top: 0;
    width: 64px;
    height: 100%;
    overflow: visible;
  }
  .pipeline__list {
    display: grid;
    gap: 1.75rem;
    padding-left: 72px;
  }
  .station {
    position: relative;
  }
  .station__dot {
    position: absolute;
    left: -72px;
    top: 1.1rem;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: 10px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--fg);
    background: var(--surface);
    border: 3px solid var(--line);
    border-radius: 50%;
    z-index: 1;
    transition:
      background-color 0.2s,
      color 0.2s,
      scale 0.4s var(--ease-spring);
  }
  .station.is-on .station__dot {
    background: var(--lime);
    color: var(--ink);
    scale: 1.08;
  }
  .station__card {
    padding: 1.1rem 1.15rem 1.2rem;
    background: var(--surface);
    border: var(--bw) solid var(--line);
    border-radius: var(--radius);
    box-shadow: 5px 5px 0 0 var(--line);
    rotate: calc(var(--tilt) * 0.5);
  }
  .station__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    color: var(--muted);
  }
  .station__verb {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
  }
  .station__name {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .station__what {
    margin-top: 0.6rem;
    font-size: 1.0625rem;
    line-height: 1.45;
  }
  .station__proof {
    margin-top: 0.9rem;
    padding-top: 0.75rem;
    border-top: 2px dashed color-mix(in oklab, var(--line) 35%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .station__proof-tag {
    display: inline-block;
    margin-right: 0.35rem;
    padding: 0 0.35rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--lime);
    border: 1.5px solid var(--ink);
    border-radius: 4px;
  }

  /* desktop: horizontal noodle, cards in a row under each station */
  @media (min-width: 64rem) {
    .pipeline {
      padding-block: 6rem 5rem;
    }
    .pipeline__counter {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      padding: 0.4rem 0.75rem;
      border: 2px solid var(--line);
      border-radius: 999px;
      background: var(--surface);
    }
    .pipeline__stage {
      display: block;
      position: relative;
      margin-top: 1.5rem;
    }
    .pipeline__vsvg,
    .station__dot {
      display: none;
    }
    .pipeline__body {
      margin-top: 0.75rem;
    }
    .pipeline__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
      padding-left: 0;
    }
    .station__card {
      height: 100%;
      padding: 1rem 1rem 1.1rem;
      rotate: var(--tilt);
    }
    .station__meta {
      flex-direction: column;
    }
    .station__name {
      font-size: clamp(1.9rem, 1rem + 1.6vw, 2.6rem);
    }
    .station__what {
      font-size: 1rem;
    }
  }

  /* live mode (JS + motion OK + desktop): pin the stage and draw on scroll */
  @media (min-width: 64rem) and (min-height: 42rem) and (prefers-reduced-motion: no-preference) {
    .pipeline.is-live {
      height: 300vh;
      padding-block: 0;
    }
    .pipeline.is-live .pipeline__pin {
      position: sticky;
      top: 0;
      display: flex;
      align-items: center;
      min-height: 100vh;
      padding-block: 2rem;
    }
    .pipeline.is-live .pw:not(.is-reached) {
      opacity: 0.28;
    }
    .pipeline.is-live .station {
      transition:
        opacity 0.25s,
        transform 0.5s var(--ease-spring);
    }
    .pipeline.is-live .station:not(.is-on) {
      opacity: 0;
      transform: translateY(24px) scale(0.94);
    }
  }
  /* live mode on mobile: draw the vertical noodle */
  .pipeline.is-live-v .station:not(.is-on) .station__dot {
    background: var(--surface);
  }
</style>

<script>
  import { fractionsAt, noodleThrough } from '@/lib/noodle';

  const section = document.querySelector<HTMLElement>('[data-pipeline]');
  if (section) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const wide = matchMedia('(min-width: 64rem) and (min-height: 42rem)');
    const desktop = matchMedia('(min-width: 64rem)');
    const draw = section.querySelector<SVGPathElement>('[data-draw]')!;
    const dots = [...section.querySelectorAll<SVGGElement>('[data-dot]')];
    const stations = [...section.querySelectorAll<HTMLElement>('[data-station]')];
    const words = [...section.querySelectorAll<HTMLElement>('[data-word]')];
    const counter = section.querySelector<HTMLElement>('[data-counter]');
    const counterName = section.querySelector<HTMLElement>('[data-counter-name]');
    const vsvg = section.querySelector<SVGSVGElement>('[data-vnoodle]')!;
    const vdraw = section.querySelector<SVGPathElement>('[data-vdraw]')!;
    const vtrack = section.querySelector<SVGPathElement>('[data-vtrack]')!;
    const list = section.querySelector<HTMLElement>('.pipeline__list')!;
    const names = stations.map((s) => s.querySelector('h3')?.textContent ?? '');

    let fracs: number[] = [];
    let vStops: Array<{ y: number; f: number }> = [];
    let raf = 0;

    const setActive = (n: number) => {
      // n = number of stations reached (0–5)
      stations.forEach((el, i) => el.classList.toggle('is-on', i < n));
      dots.forEach((el, i) => el.classList.toggle('is-on', i < n));
      words.forEach((el, i) => {
        el.classList.toggle('is-reached', i < n);
        el.classList.toggle('is-current', i === n - 1);
      });
      if (counter) counter.textContent = String(Math.max(n, 1)).padStart(2, '0');
      if (counterName) counterName.textContent = names[Math.max(n, 1) - 1] ?? '';
    };

    const measureDesktop = () => {
      const xs = dots.map((g) => g.transform.baseVal.consolidate()?.matrix.e ?? 0);
      fracs = fractionsAt(draw, xs.map((x) => [x, 112] as [number, number]));
    };

    const buildVertical = () => {
      const listRect = list.getBoundingClientRect();
      const height = Math.round(listRect.height);
      const ys = stations.map((st) => {
        const dot = st.querySelector<HTMLElement>('.station__dot')!;
        const r = dot.getBoundingClientRect();
        return r.top + r.height / 2 - listRect.top;
      });
      const d = noodleThrough(ys, { start: 0, end: height, vScale: 0.36, map: (u, v) => [32 + v, u] });
      vsvg.setAttribute('viewBox', `0 0 64 ${height}`);
      vdraw.setAttribute('d', d);
      vtrack.setAttribute('d', d);
      const f = fractionsAt(vdraw, ys.map((y) => [32, y] as [number, number]));
      vStops = [{ y: 0, f: 0 }, ...ys.map((y, i) => ({ y, f: f[i]! })), { y: height, f: 1 }];
    };

    const live = () => !reduce.matches;

    const update = () => {
      raf = 0;
      if (!live()) return;
      if (desktop.matches) {
        if (!wide.matches) return;
        const r = section.getBoundingClientRect();
        const span = r.height - innerHeight;
        const p = Math.min(1, Math.max(0, -r.top / span));
        const drawn = Math.min(1, p * 1.12);
        draw.style.strokeDashoffset = String(1 - drawn);
        setActive(fracs.filter((f) => f <= drawn + 0.004).length);
      } else {
        const r = list.getBoundingClientRect();
        const pen = innerHeight * 0.62 - r.top;
        let f = 0;
        if (pen >= vStops.at(-1)!.y) f = 1;
        else if (pen > 0) {
          const i = vStops.findIndex((s) => s.y > pen);
          const a = vStops[i - 1]!;
          const b = vStops[i]!;
          f = a.f + ((pen - a.y) / (b.y - a.y)) * (b.f - a.f);
        }
        vdraw.style.strokeDashoffset = String(1 - f);
        setActive(vStops.slice(1, -1).filter((s) => s.y <= pen).length);
      }
    };

    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    const setup = () => {
      section.classList.remove('is-live', 'is-live-v');
      draw.style.strokeDasharray = '';
      draw.style.strokeDashoffset = '';
      vdraw.style.strokeDasharray = '';
      vdraw.style.strokeDashoffset = '';
      if (!desktop.matches) buildVertical();
      if (!live()) {
        setActive(stations.length);
        return;
      }
      if (desktop.matches && wide.matches) {
        measureDesktop();
        section.classList.add('is-live');
        draw.style.strokeDasharray = '1';
      } else if (!desktop.matches) {
        section.classList.add('is-live-v');
        vdraw.style.strokeDasharray = '1';
      }
      update();
    };

    setup();
    addEventListener('scroll', schedule, { passive: true });
    let resizeTimer = 0;
    const ro = new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(setup, 120);
    });
    ro.observe(list);
    [reduce, wide, desktop].forEach((m) => m.addEventListener('change', setup));
  }
</script>

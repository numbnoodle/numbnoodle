# Copy to .env (or set these in your host's dashboard). All are read at BUILD time.
# Analytics is OFF unless PUBLIC_ANALYTICS is set. Scripts load after the page is
# idle and never block first paint (see src/components/global/Analytics.astro).

# Which provider to load: plausible | amplitude. Leave empty for no analytics.
PUBLIC_ANALYTICS=

# Plausible: the site domain as registered in Plausible. Defaults to numbnoodle.com.
PUBLIC_PLAUSIBLE_DOMAIN=numbnoodle.com

# Amplitude: browser API key. Required when PUBLIC_ANALYTICS=amplitude, otherwise
# analytics stays off.
PUBLIC_AMPLITUDE_API_KEY=
